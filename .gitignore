# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# sqlite sidecar files; the app database is committed
/data/*.db-*
/data/*.db
!/data/reqpro.db

# uploaded request attachments
/data/uploads/*
!/data/uploads/.gitkeep

# local email outbox when SMTP is not configured
/data/mail-outbox/*
!/data/mail-outbox/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
